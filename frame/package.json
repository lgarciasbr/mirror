{
  "name": "mirror-frame",
  "version": "0.2.0",
  "private": true,
  "description": "Mirror Mind desktop frame for Windows (ES-004 Fusão A+C): tabbed Pi sessions over ConPTY with guided setup",
  "main": "main/main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test \"tests/**/*.test.js\"",
    "sim": "node sim/sim-session.mjs",
    "package": "electron-packager . MirrorFrame --platform=win32 --arch=x64 --out=out --overwrite --icon=assets/mirror.ico"
  },
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-packager": "^17.1.2"
  },
  "dependencies": {
    "@lydell/node-pty": "^1.1.0",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0"
  }
}
